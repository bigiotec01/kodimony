<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.program.latinboy" name="Latin Kodi Wizard" version="1.0.7" provider-name="Latin Kodi">
	<requires>
		<import addon="xbmc.python" version="3.0.1"/>
		<import addon="script.module.requests" version="2.22.0"/>
	</requires>
	<extension point="xbmc.python.pluginsource" library="addon.py">
		<provides>executable</provides>
	</extension>
	<extension point="xbmc.service" library="service.py" />
	<extension point="xbmc.addon.metadata">
		<summary lang="es_es">Latin Kodi Wizard</summary>
		<description lang="es_es">Instalá y gestioná tu Build de Kodi de forma fácil y rápida. Incluye builds listas para usar, herramientas de mantenimiento, respaldo y restauración.</description>
		<disclaimer lang="es_es">Este add-on no contiene ningún tipo de contenido multimedia.</disclaimer>
		<language>es</language>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<forum></forum>
		<website></website> 
		<email></email>
		<source></source>
		<news></news>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
<addon id="repository.latinboy" name="Latin Kodi Wizard Repository" version="1.0.0" provider-name="Latin Kodi">
	<extension point="xbmc.addon.repository" name="Latin Kodi Wizard Repository">
		<dir>
			<info compressed="false">https://kodimony-henna.vercel.app/repo/addons.xml</info>
			<checksum>https://kodimony-henna.vercel.app/repo/addons.xml.md5</checksum>
			<datadir zip="false">https://kodimony-henna.vercel.app/repo/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="es_es">Repositorio de Latin Kodi Wizard</summary>
		<description lang="es_es">Repositorio oficial para instalar y actualizar Latin Kodi Wizard.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
</addons>
